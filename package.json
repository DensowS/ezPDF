{
  "name": "ezpdf",
  "version": "0.2.1",
  "description": "A focused, local-first PDF editor for Windows",
  "author": "DensowS",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "format": "prettier --write src desktop tests docs scripts assets *.json *.ts *.html *.md .github .prettierrc.json",
    "format:check": "prettier --check src desktop tests docs scripts assets *.json *.ts *.html *.md .github .prettierrc.json",
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "npm run icons && tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:desktop": "node tests/desktop.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "electron": "45.2.3",
    "electron-builder": "^26.0.0",
    "playwright": "latest",
    "prettier": "^3.9.10",
    "tsx": "latest",
    "typescript": "^5.9.0",
    "vite": "8.3.7"
  },
  "build": {
    "appId": "de.ezpdf.desktop",
    "productName": "ezPDF",
    "executableName": "ezPDF",
    "copyright": "Copyright © 2026 DensowS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
